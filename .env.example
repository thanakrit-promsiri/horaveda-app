# ==============================================================================
# Horaveda App — Environment Configuration Example
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ไขค่าจริงก่อนรันเซิร์ฟเวอร์ (cp .env.example .env)
# ==============================================================================

# --- Server & Security Configuration ---
PORT=8082
APP_ENV=development
CORS_ORIGIN=https://hora.garbagecollection.info
COOKIE_SECURE=false
JWT_SECRET=replace_with_your_strong_jwt_secret_key
ADMIN_API_KEY=replace_with_your_admin_api_key

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Lahiri Horoscope Calculation Service ---
HORA_API_URL=http://localhost:8083/api/v1/hora/prompt
HORA_TRANSIT_API_URL=http://localhost:8083/api/v1/hora/transitdasha_prompt

# --- AnythingLLM Developer API ---
ANYTHINGLLM_API_URL=http://localhost:3001/api/v1
ANYTHINGLLM_API_KEY=your_anythingllm_developer_api_key
ANYTHINGLLM_TIMEOUT_SECONDS=120
